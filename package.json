{
  "name": "kuuns-kanban-calendar",
  "productName": "쿤스 칸반 캘린더",
  "version": "1.9.8",
  "description": "로컬 저장 기반 Windows/macOS 작업 캘린더 및 선택 일정 공유",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "KUN'S KANBAN CALENDAR",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64",
    "configure:github": "node scripts/configure-github.cjs",
    "publish:win": "electron-builder --win nsis --x64 --publish always",
    "build:mac": "electron-builder --mac dmg --universal --publish never -c.productName=KuunsKanbanCalendar"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.kuuns.kanban.calendar",
    "productName": "쿤스 칸반 캘린더",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/app.ico",
      "artifactName": "KuunsKanbanCalendar-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "쿤스 칸반 캘린더",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "kun-blip",
      "repo": "kuns-kanban-calendar",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/app-mac.png",
      "artifactName": "KuunsKanbanCalendar-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "쿤스 칸반 캘린더"
      }
    },
    "protocols": [
      {
        "name": "KUNS KANBAN Calendar Invitation",
        "schemes": [
          "kuuns-kanban"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kun-blip/kuns-kanban-calendar.git"
  }
}
